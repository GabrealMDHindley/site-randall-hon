# Copy to .env.local for local development. In production, set these in
# Vercel -> Project -> Settings -> Environment Variables instead (see README.md).

# Powers the AI chat widget (bottom-right button). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Go High Level "Inbound Webhook" URL for the Contact page form. Leads are still
# accepted and logged without this, but won't reach your CRM until it's set.
GHL_WEBHOOK_URL=

# Production URL, used for the sitemap and OpenGraph tags. Optional locally.
NEXT_PUBLIC_SITE_URL=https://site-randall-hon.vercel.app
